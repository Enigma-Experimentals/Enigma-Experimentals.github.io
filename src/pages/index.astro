---

import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
---


<Layout>
	<Hero>

		<h1>Engima Experimentals</h1>
		<hr>
		<h3>Technology & Development</h3>
		<p class="date">Last updated: {new Date().toLocaleDateString()}</p>
	</Hero>

	<div id="read-more" >
		<hr>
		<h2>Read more about us.</h2>
		<div class="arrow-down"></div>
		<hr>
	</div>
	

	<div id="about-us" class="general-spacing">
		<h2>Our Work</h2>
		<div class="about-grid">
			<div class="about-card">
				<h4>🌐 Website Development</h4>
				<p>Static websites for you or your business</p>
			</div>
			<div class="about-card">
				<h4>⚙️ Server Development</h4>
				<p>Backend servers for system management or apps</p>
			</div>
			<div class="about-card">
				<h4>🧊 3d Modeling</h4>
				<p>Quick visuals and scale models to use or to gain a view into a project.</p>
			</div>
		</div>
	</div>
	<div id="future-planned" class="general-spacing">
		<h2>Planned Items</h2>
		<div class="about-grid">
			<div class="about-card">
				<h4>🔍 OSINT</h4>
				<p>Search public data for intel on items.</p>
			</div>
			<div class="about-card">
				<h4>🔒 OPSEC</h4>
				<p>Security testing and safety</p>
			</div>
			<div class="about-card">
				<h4>📊 Data Analysis </h4>
				<p>Large Scale data collection and processing for use and statistics</p>
			</div>
			<div class="about-card">
				<h4>⚙️ Engineering </h4>
				<p>Generalized Engineering</p>
			</div>
		</div>
	</div>
	<div id="contact">
		<h2>Contact Us</h2>
		<div class="contact-grid">
			<div class="contact-card">
				<h3>📧 Email</h3>
				<p>Cyborgnetical@gmail.com</p>
			</div>
		</div>
		<div class="contact-info">
			<p class="contact-text">Feel free to reach out, this business is run by one person so far so I should respond within one day lol.</p>
		</div>
	</div>
</Layout>

<style>
	.general-spacing{
		padding: 40px 20px;
		max-width: 1200px;
		margin: 0 auto;
	}

	#contact {
		padding: 25px;
		margin: 0;
	}

	.about-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
		margin-top: 20px;
	}

	.about-card {
		background: rgba(255, 255, 255, 0.9);
		padding: 24px;
		border-radius: 12px;
		border: 2px solid #e2e8f0;
		box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
	

	.about-card:hover {
		transform: translateY(-2px);
		box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
	}

	.about-card h4 {
		margin: 0 0 12px 0;
		color: #1e293b;
		font-size: 1.1rem;
	}

	.about-card p {
		margin: 0;
		color: #64748b;
		line-height: 1.5;
	}

	/* Responsive design */
	@media (max-width: 768px) {
		.about-grid {
			grid-template-columns: 1fr;
		}
	}
	#read-more {
		text-align: center;
		padding: 10px 20px;
	}

	#read-more h2 {
		font-size: 1.5rem;
		
		margin: 0 0 16px 0;
		font-weight: 400;
	}

	.arrow-down {
		width: 0;
		height: 0;
		border-left: 12px solid transparent;
		border-right: 12px solid transparent;
		border-top: 12px solid #3b82f6;
		margin: 0 auto;
		animation: bounce 2s infinite;
	}

	@keyframes bounce {
		0%, 20%, 50%, 80%, 100% {
			transform: translateY(0);
		}
		40% {
			transform: translateY(-8px);
		}
		60% {
			transform: translateY(-4px);
		}
	}
#contact {
		background-color: #0f172a;
		color: #e2e8f0;
	}

	.contact-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
		margin-top: 20px;
	}

	.contact-card {
		background: rgba(255, 255, 255, 0.1);
		padding: 24px;
		border-radius: 12px;
		border: 2px solid rgba(255, 255, 255, 0.2);
		transition: transform 0.2s ease, background-color 0.2s ease;
		text-align: center;
	}

	.contact-card:hover {
		transform: translateY(-2px);
		background: rgba(255, 255, 255, 0.15);
	}

	.contact-card h3 {
		margin: 0 0 12px 0;
		color: #f1f5f9;
		font-size: 1.2rem;
	}

	.contact-card p {
		margin: 0;
		color: #cbd5e1;
		line-height: 1.5;
	}

	.contact-info {
		margin-top: 32px;
		text-align: center;
	}

	.contact-text {
		font-size: 1.1rem;
		color: #94a3b8;
		line-height: 1.6;
		max-width: 600px;
		margin: 0 auto;
	}

	/* Responsive design for contact section */
	@media (max-width: 768px) {
		.contact-grid {
			grid-template-columns: 1fr;
		}
	}
</style>